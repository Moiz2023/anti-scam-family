# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais commiter le fichier .env (voir .gitignore).

# --- Supabase (utilise par les scripts CLI : scripts/eval.mjs, supabase functions serve) ---
# En local avec `supabase start`, ces valeurs sont affichees dans le terminal
# (API URL et anon key). En production, dans Project Settings > API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase cote app mobile (memes valeurs, prefixees EXPO_PUBLIC_ pour que
# Metro les inline dans le bundle client — l'anon key est concue pour etre
# publique, ne jamais mettre la service_role key ici) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude / Anthropic (utilise par la fonction /analyze) ---
# A definir aussi cote Supabase avec:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
